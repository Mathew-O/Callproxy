# Copy to .env (repo root) and fill in. Simulated calls work with none of this set.

# --- Twilio (upgrade the account: trial accounts play an announcement and only dial verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +12155550100
TWILIO_NUMBER=
# Check X-Twilio-Signature on webhooks. Set to false only if the tunnel rewrites URLs.
TWILIO_VALIDATE_SIGNATURES=true
RING_TIMEOUT_SECONDS=30

# --- Public URL of this backend (cloudflared or ngrok), no trailing slash
# e.g. https://your-tunnel.trycloudflare.com
PUBLIC_URL=

# --- Only these numbers can be dialed (team and judge phones). Comma separated.
# e.g. +12155550142,+12155550199
ALLOWED_NUMBERS=
# The judge's phone for the one-click live demo (defaults to the first ALLOWED_NUMBERS entry).
DEMO_NUMBER=

# --- Voice model. auto = ElevenLabs when ELEVENLABS_API_KEY is set, otherwise OpenAI.
VOICE_PROVIDER=auto

# --- ElevenLabs Agents. CallProxy creates and syncs its own agent and tools on the first live call.
ELEVENLABS_API_KEY=
# Optional: use an agent you already made instead (it gets CallProxy's settings applied).
ELEVENLABS_AGENT_ID=
# The agent's default voice ("Sarah"). Any voice id from your ElevenLabs library works.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# The default voice that reads what the user types ("River": calm, gender-neutral).
ELEVENLABS_MY_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_LLM=gemini-2.5-flash
ELEVENLABS_TTS_MODEL=eleven_flash_v2
# patient | normal | eager. "patient" suits a noisy room or slow talkers.
ELEVENLABS_TURN_EAGERNESS=normal

# --- Voice model: OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Turn detection. For a speakerphone in a loud room try VAD_THRESHOLD=0.7 and NOISE_REDUCTION=far_field.
VAD_THRESHOLD=0.6
VAD_SILENCE_MS=500
VAD_PREFIX_MS=300
NOISE_REDUCTION=near_field

# --- Call rules
MAX_CALL_SECONDS=300
ASK_USER_TIMEOUT_SECONDS=30

# --- Simulator pacing (2 = twice as fast)
SIMULATOR_SPEED=1
